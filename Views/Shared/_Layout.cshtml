<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SakilaWebMVC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">SAKILA <span class="text-info">MVC</span></a>
            <div class="navbar-nav flex-row gap-3">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                <a class="nav-link" asp-controller="Country" asp-action="Index">Países</a>
                <a class="nav-link" asp-controller="City" asp-action="Index">Ciudades</a>
            </div>
        </div>
    </nav>
    <main class="container pb-5">
        @if (TempData["Success"] is string success) { <div class="alert alert-success" role="alert">@success</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
        @RenderBody()
    </main>
    <footer class="container border-top pt-3 text-muted small">Laboratorio ESPE · ASP.NET Core MVC · ADO.NET · SQL Server</footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
