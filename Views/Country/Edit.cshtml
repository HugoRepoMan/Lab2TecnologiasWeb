<div class="card p-4 shadow-sm"><form asp-action="Edit" asp-route-id="@Model.CountryId" method="post"><input type="hidden" asp-for="CountryId" /><partial name="_Form" model="Model" /></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
