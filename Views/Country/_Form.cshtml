@model Country
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="CountryName" class="form-label"></label><input asp-for="CountryName" class="form-control" maxlength="50" /><span asp-validation-for="CountryName" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Guardar</button>
<a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
